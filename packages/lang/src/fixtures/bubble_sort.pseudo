PROCEDURE bubbleSort(IN/OUT arr: ARRAY[1..1000] OF INTEGER, IN n: INTEGER)
DICTIONARY
	i, j, temp: INTEGER
ALGORITHM
	FOR i = 1 TO n - 1
		FOR j = 1 TO n - i
			IF arr[j] > arr[j + 1] THEN
				temp = arr[j]
				arr[j] = arr[j + 1]
				arr[j + 1] = temp
			ENDIF
		ENDFOR
	ENDFOR
ENDPROCEDURE

PROGRAM SortDemo
DICTIONARY
	data: ARRAY[1..1000] OF INTEGER
	i: INTEGER
	seed: INTEGER
ALGORITHM
	seed = 12345
	FOR i = 1 TO 1000
		seed = (seed * 1103515245 + 12345) MOD 2147483647
		IF seed < 0 THEN
			seed = seed * -1
		ENDIF
		data[i] = seed MOD 100000
	ENDFOR
	bubbleSort(data, 1000)
	OUTPUT "First:", data[1]
	OUTPUT "Last:", data[1000]
	OUTPUT "Sorted check (should be 1 for sorted):"
	FOR i = 1 TO 999
		IF data[i] > data[i + 1] THEN
			OUTPUT 0
		ENDIF
	ENDFOR
	OUTPUT 1
ENDPROGRAM
