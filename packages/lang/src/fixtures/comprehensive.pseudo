-- This program exercises WHILE, ELSE IF, NOT/AND/OR, MOD, comments, nested arrays/structs.
TYPE Point STRUCT <
	x: INTEGER
	y: INTEGER
>

/* Block comment
   spanning multiple lines */
FUNCTION classify(n: INTEGER) -> STRING
DICTIONARY
	label: STRING
ALGORITHM
	IF n MOD 2 == 0 AND n > 0 THEN
		label = "positive even"
	ELSE IF n MOD 2 != 0 THEN
		label = "odd-ish"
	ELSE
		label = "other"
	ENDIF
	RETURN label
ENDFUNCTION

PROCEDURE resetOut(OUT z: INTEGER)
DICTIONARY
ALGORITHM
	z = 99
ENDPROCEDURE

PROGRAM Comprehensive
DICTIONARY
	i, count: INTEGER
	grid: ARRAY[1..2] OF ARRAY[1..2] OF INTEGER
	origin: Point
	flag: BOOLEAN
	junk: INTEGER
ALGORITHM
	count = 0
	i = 1
	WHILE i <= 5
		IF NOT (i == 3) THEN
			count = count + 1
		ENDIF
		i = i + 1
	ENDWHILE
	OUTPUT "count:", count

	grid[1][1] = 10
	grid[1][2] = 20
	grid[2][1] = 30
	grid[2][2] = 40
	OUTPUT grid[1][1] + grid[2][2]

	origin.x = 7
	origin.y = 8
	OUTPUT origin.x, origin.y

	flag = (5 > 3) OR (2 > 10)
	OUTPUT flag

	OUTPUT classify(4)
	OUTPUT classify(7)

	junk = 123
	resetOut(junk)
	OUTPUT junk
ENDPROGRAM
